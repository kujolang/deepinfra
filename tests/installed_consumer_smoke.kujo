test_setup { from deepinfra import create_client, client_chat, deepinfra_provider }
test "installed exports resolve" { c:=create_client({"api_key":"fixture","transport":func(url,o) { return Ok({"_status":200,"_body":"{\"choices\":[]}"}) }}); assert_true(client_chat(c,{})["ok"]); assert_equal(type(deepinfra_provider({})),"dict") }
